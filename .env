# Database URL, default uses SQLite file (dev)
DATABASE_URL=sqlite:///./intraq_meta.db

# If you use Postgres:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/intraq

# Optional uploads folder
UPLOAD_FOLDER=./uploads
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_ACCESS_TOKEN=your_permanent_meta_token
WHATSAPP_PHONE_ID=123456789012345
